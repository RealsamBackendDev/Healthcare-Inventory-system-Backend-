NODE_ENV=development
PORT=4000

DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=healthcare_inventory
DB_SSL=false

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
JWT_ISSUER=healthcare-inventory

BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

STAFF_ADJUSTMENT_QUANTITY_THRESHOLD=10
STAFF_ADJUSTMENT_VALUE_THRESHOLD=5000
NEAR_EXPIRY_DAYS=90

ADMIN_EMAIL=admin@healthcentre.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=System Administrator

STAFF_EMAIL=staff@healthcentre.local
STAFF_PASSWORD=Staff123!

CENTRE_NAME=Primary Healthcare Centre
CENTRE_CODE=PHC-001
STATE_NAME=Lagos
STATE_CODE=LA
LOCAL_GOVERNMENT_NAME=Ikeja
LOCAL_GOVERNMENT_CODE=IKEJA

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

EXPIRY_JOB_ENABLED=true
EXPIRY_JOB_INTERVAL_HOURS=24
